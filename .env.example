# =============================================================================
# AutoForge — 환경 변수 예시
# 사용법: cp .env.example .env 후 값을 채워 넣으세요.
# =============================================================================

# -----------------------------------------------------------------------------
# 서버
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# -----------------------------------------------------------------------------
# AI API 키 (OmniRoute gateway, Cursor는 workspace executor legacy 경로)
# -----------------------------------------------------------------------------
# OmniRoute OpenAI-compatible gateway. The default matches the local OmniRoute
# server (`omniroute`, API on port 20128). Compose에서 호스트의 OmniRoute를
# 사용할 때는 http://host.containers.internal:20128/v1 로 변경하세요.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# 인스턴스의 GET /v1/models에서 확인한 ID를 설정하세요. 추측한 기본 ID는 없습니다.
OMNIROUTE_MODEL_EXTRACT=
OMNIROUTE_MODEL_PLAN=
OMNIROUTE_MODEL_PLAN_ESCALATION=
OMNIROUTE_MODEL_CODE=
OMNIROUTE_MODEL_DEBUG=
OMNIROUTE_MODEL_DEBUG_ALT=
OMNIROUTE_MODEL_DEBUG_ESCALATION=

# 입력은 보수적 추정치이며 초과 시 원문을 자르지 않고 실패합니다.
AI_MAX_INPUT_TOKENS=30000
AI_EXTRACT_OUTPUT_TOKENS=16000
AI_CLARIFY_OUTPUT_TOKENS=2000
AI_PLAN_OUTPUT_TOKENS=16000
AI_DIAGNOSIS_OUTPUT_TOKENS=4000

# Cursor Cloud Agents API — Implement / Verify / Debug patch / SecurityPatch
# 프로젝트별 모델을 선택하지 않으면 Cursor 계정의 기본 모델을 사용합니다.
CURSOR_API_KEY=

# Google Stitch MCP — Design 단계 UI 생성
# API 키: 프로젝트 생성/조회 등 (stitch.withgoogle.com/settings)
STITCH_API_KEY=

# AI 화면 생성(generate_screen)용 OAuth Bearer — API 키만으로는 생성 불가
# 아래 중 하나면 자동 갱신됩니다 (수동 print-access-token 불필요):
#   1) gcloud auth application-default login  → ~/.config/gcloud/application_default_credentials.json
#   2) GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json (Compose 볼륨 마운트)
#   3) STITCH_ACCESS_TOKEN=... (정적 토큰, ~1시간 만료 — 만료되면 삭제하고 1) 또는 2) 사용)
STITCH_ACCESS_TOKEN=

# Figma REST API — Design 단계(design_source=figma)에서 디자인 파일 PNG export
# https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=

# Bearer 인증 시 GCP quota 프로젝트 (필수에 가깝음). 미설정 시 gcloud config project 자동 사용
# gcloud config set project YOUR_PROJECT_ID
GOOGLE_CLOUD_PROJECT=

# -----------------------------------------------------------------------------
# GitHub 자동화
# -----------------------------------------------------------------------------
# PAT (repo 권한) — 프라이빗 레포 자동 생성, PR 자동 머지
GITHUB_TOKEN=

# 조직 이름 (비우면 사용자 계정에 레포 생성)
GITHUB_ORG=

# SecurityPatch 통과 후 PR squash merge (기본: true)
GITHUB_AUTO_MERGE=true

# 파이프라인 산출물 git 자동 커밋 (기본: true) + 일일 push 시각 UTC (기본: 23시)
GIT_AUTO_COMMIT=true
GIT_DAILY_PUSH_HOUR_UTC=23

# 웹 대시보드 공개 URL (Slack 일일 경과 링크)
PUBLIC_URL=http://localhost:8080

# GitHub 미설정 시 구현 단계에 사용할 기존 레포 URL
DEFAULT_REPO_URL=

# -----------------------------------------------------------------------------
# 보안
# -----------------------------------------------------------------------------
# 설정 시 /v1/* API에 Authorization: Bearer <key> 인증을 강제한다.
# 운영 환경에서는 반드시 설정할 것 (미설정 시 API가 인증 없이 열려있음)
API_KEY=

# 웹 대시보드 세션 로그인 (아이디/비밀번호 1세트)
# 세 값이 모두 설정되면 브라우저에서 로그인 페이지로 접속할 수 있다.
LOGIN_USERNAME=
LOGIN_PASSWORD=
# 세션 쿠키 서명 키 (32자 이상 랜덤 문자열 권장)
SESSION_SECRET=

# 원격 coder용 아티팩트 토큰 서명 키 (미설정 시 SESSION_SECRET 사용, 32자 이상 권장)
ARTIFACT_SIGNING_SECRET=
# coder에게 노출 가능한 생성 아티팩트 최대 크기 (bytes, 기본 256KB)
CODER_ARTIFACT_MAX_BYTES=262144

# CORS 허용 오리진 (콤마 구분, 예: https://app.example.com,https://admin.example.com)
# 미설정 시 모든 오리진 허용 (로컬 개발용)
CORS_ALLOWED_ORIGINS=

# 업로드 최대 크기 (bytes, 기본 50MB)
MAX_UPLOAD_BYTES=52428800

# -----------------------------------------------------------------------------
# 아티팩트 저장소 & 이미지 호스팅 (로컬 디스크)
# -----------------------------------------------------------------------------
# 파이프라인 산출물 + 업로드 이미지를 저장할 로컬 경로.
# Compose 환경에서는 api/worker/orchestrator가 공유하는 볼륨으로 마운트됩니다.
ARTIFACTS_DIR=./data/artifacts

# 이미지 업로드 최대 크기 (bytes, 기본 10MB)
MAX_IMAGE_BYTES=10485760

# -----------------------------------------------------------------------------
# 품질 게이트
# -----------------------------------------------------------------------------
# Verify 실패 시 Debug 재시도 횟수 (기본: 3)
MAX_DEBUG_CYCLES=4

# AI usage budgets and bounded escalation
AI_PROJECT_BUDGET_USD=3.00
AI_TASK_BUDGET_USD=0.30
# 호출별 예산 예약 상한 (USD). provider 호출 전에 원장에 보수적으로 예약한다.
AI_MAX_CALL_COST_USD=0.50
AI_DEEPSEEK_DEBUG_RETRIES=2
AI_MID_DEBUG_RETRIES=1
AI_OPUS_MAX_CALLS=1
AI_ASTRA_MAX_CALLS=1

# -----------------------------------------------------------------------------
# RabbitMQ 메시지 큐 (Podman 분산 배포)
# -----------------------------------------------------------------------------
# 로컬 단일 프로세스: false / Podman compose: true
MESSAGE_QUEUE_ENABLED=false

# 프로젝트 스토어 + 실시간 알림 (pub/sub)
REDIS_URL=redis://127.0.0.1:6379

# 파이프라인 커맨드/이벤트 큐 (AMQP)
RABBITMQ_URL=amqp://autoforge:autoforge@127.0.0.1:5672/%2F
RABBITMQ_USER=autoforge
RABBITMQ_PASSWORD=autoforge
QUEUE_COMMANDS_STREAM=autoforge.commands
QUEUE_EVENTS_STREAM=autoforge.events
QUEUE_CONSUMER_GROUP=autoforge
# 프로세스당 동시 스테이지 실행 수 (MQ worker 컨테이너 1개 기준)
WORKER_CONCURRENCY=4
PODMAN_WORKER_IMAGE=localhost/autoforge-api:latest

# -----------------------------------------------------------------------------
# Compose (Docker / Podman)
# -----------------------------------------------------------------------------
# Podman rootless: ./scripts/podman-up.sh 가 IMAGE_PREFIX=localhost/ 를 자동 설정
# Docker: 비워두거나 주석 처리
# IMAGE_PREFIX=localhost/
# 기본 8080 (rootless Podman 호환). Docker에서 80번 쓰려면 HOST_HTTP_PORT=80
HOST_HTTP_PORT=8080

# Worker / Orchestrator 전용 (compose.yml에서 사용)
# STAGE_FILTER=implement
# WORKER_ID=worker-1
# ORCHESTRATOR_ID=orchestrator-1

# -----------------------------------------------------------------------------
# Slack 알림 (선택)
# -----------------------------------------------------------------------------
# Webhook 방식 (간단)
SLACK_WEBHOOK_URL=

# Bot Token + 채널 (스레드 업데이트용)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
