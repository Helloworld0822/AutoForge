# syntax=docker/dockerfile:1

FROM docker.io/library/rust:1-bookworm AS rust-tools
RUN rustup component add clippy rustfmt

FROM rust-tools AS builder
WORKDIR /build
COPY Cargo.toml ./
COPY Cargo.lock* ./
COPY src ./src
RUN cargo build --release

# Repository tasks execute here, so retain Rust and the native build toolchain.
FROM rust-tools AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    nodejs \
    npm \
    poppler-utils \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --shell /usr/sbin/nologin autoforge
RUN npm install --global @openai/codex@0.163.0

WORKDIR /app
COPY --from=builder /build/target/release/autoforge /usr/local/bin/autoforge

ENV HOST=0.0.0.0
ENV PORT=8080
ENV RUST_LOG=info
ENV ARTIFACTS_DIR=/data/artifacts

RUN mkdir -p /data/artifacts && chown -R autoforge:autoforge /data

USER autoforge
VOLUME ["/data/artifacts"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/autoforge"]
CMD ["serve"]
